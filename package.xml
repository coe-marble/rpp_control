<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rpp_control</name>
  <version>0.0.1</version>
  <description>ROS-independent RPP control and reference plugins.</description>
  <maintainer email="luka.mandic@fer.hr">luka</maintainer>
  <license>TODO: License declaration</license>
  <depend>rpp_cpp</depend>
  <depend>rpp_interfaces</depend>
  <depend>rpp_ros2</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>nav2_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav_msgs</depend>
  <depend>rpp_ros_interfaces</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <rpp_dependencies>
      <depend>rpp_interfaces</depend>
    </rpp_dependencies>
  </export>
</package>
